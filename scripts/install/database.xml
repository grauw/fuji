<?xml version="1.0"?>
<!DOCTYPE schema SYSTEM "../database_axmls.dtd">
<schema version="0.2">
	
	<table name="entries">
		<descr>Entry in the forum</descr>
		<field name="id" type="I"><KEY/><AUTOINCREMENT/><UNSIGNED/></field>
		<field name="ref" type="I"><UNSIGNED/></field>
		<field name="userref" type="I"><NOTNULL/><UNSIGNED/></field>
		<field name="title" type="C" size="255"><NOTNULL/></field>
		<field name="content" type="X2"><NOTNULL/></field>
		<field name="processor" type="C" size="255"><NOTNULL/></field>
		<field name="created" type="T"></field>
		<field name="modified" type="T"></field>
		<field name="type" type="I1"><NOTNULL/></field>
		
		<data>
			<row><f name="id">1</f><f name="content"></f><f name="userref">2</f><f name="title">root</f><f name="created" value="NOW()"/><f name="modified" value="NOW()"/><f name="type">1</f><f name="processor">none</f></row>
			<row><f name="id">2</f><f name="ref">1</f><f name="content"></f><f name="userref">2</f><f name="title">Fora</f><f name="created" value="NOW()"/><f name="modified" value="NOW()"/><f name="type">2</f><f name="processor">none</f></row>
			<row><f name="id">3</f><f name="ref">2</f><f name="content"></f><f name="userref">2</f><f name="title">Forum 1</f><f name="created" value="NOW()"/><f name="modified" value="NOW()"/><f name="type">3</f><f name="processor">none</f></row>
		</data>
	</table>
	
	<table name="views">
		<descr>### Forum view (typeref in viewtemplates)</descr>
		<field name="id" type="I1"><KEY/><AUTOINCREMENT/><UNSIGNED/></field>
		<field name="description" type="C" size="255"><NOTNULL/></field>
		<field name="publicuri" type="C" size="255"><NOTNULL/></field>
	</table>
	
	<table name="templates">
		<descr>Output templates</descr>
		<field name="mimetype" type="C" size="255"><KEY/></field>
		<field name="quality" type="C" size="5"><NOTNULL/><DEFAULT value="0.5"/></field>
		<field name="public" type="L"><NOTNULL/></field>
		<field name="basedir" type="C" size="255"><NOTNULL/></field>
		
		<data>
			<row><f name="mimetype">application/xhtml+xml</f><f name="public">1</f><f name="basedir">templates/xhtml/functions.php</f></row>
			<row><f name="mimetype">text/html</f><f name="public">1</f><f name="basedir">templates/xhtml/functions.php</f></row>
			<row><f name="mimetype">application/x-fuji+xhtml+xml</f><f name="public">1</f><f name="basedir">templates/ajax/functions.php</f></row>
			<row><f name="mimetype">application/rss+xml</f><f name="public">1</f><f name="basedir">templates/rss/functions.php</f></row>
			<row><f name="mimetype">application/atom+xml</f><f name="public">1</f><f name="basedir">templates/atom/functions.php</f></row>
			<row><f name="mimetype">application/wml+xml</f><f name="public">1</f><f name="basedir">templates/wml/functions.php</f></row>
		</data>
	</table>
	
	<table name="users">
		<descr>User information</descr>
		<field name="id" type="I"><KEY/><AUTOINCREMENT/><UNSIGNED/></field>
		<field name="nickname" type="C" size="255"><NOTNULL/></field>
		<field name="email" type="C" size="255"><NOTNULL/></field>
		<field name="email_visible" type="L"><NOTNULL/><DEFAULT value="0"/></field>
		<field name="password" type="C" size="40"><NOTNULL/></field>
		<field name="language" type="C" size="12"></field>
		<field name="style" type="C" size="255"></field>
		<field name="picture" type="C" size="255"></field>
		<field name="visual_effects" type="L"><NOTNULL/><DEFAULT value="1"/></field>
		<field name="templateref" type="I1"><NOTNULL/><DEFAULT value="2"/><UNSIGNED/></field>
		<field name="inputmethod" type="I"><NOTNULL/><DEFAULT value="2"/><UNSIGNED/></field>
	</table>
	
	<table name="groups">
		<descr>Groups</descr>
		<field name="id" type="I"><KEY/><AUTOINCREMENT/><UNSIGNED/></field>
		<field name="name" type="C" size="255"><NOTNULL/></field>
		
		<data>
			<row><f name="name">Operators</f></row>
			<row><f name="name">Users</f></row>
			<row><f name="name">Guests</f></row>
		</data>
	</table>
	
	<table name="groupmembers">
		<descr>Group members link</descr>
		<field name="groupid" type="I"><KEY/><UNSIGNED/></field>
		<field name="userid" type="I"><KEY/><UNSIGNED/></field>
		
		<data>
			<row><f>1</f><f>2</f></row>
			<row><f>3</f><f>1</f></row>
		</data>
	</table>
	
	<table name="grouprights">
		<descr>Group rights for an entry</descr>
		<field name="entryid" type="I"><KEY/><UNSIGNED/></field>
		<field name="groupid" type="I"><KEY/><UNSIGNED/></field>
		<field name="may_read" type="L"><NOTNULL/><DEFAULT value="0"/></field>
		<field name="may_post" type="L"><NOTNULL/><DEFAULT value="0"/></field>
		<field name="may_edit" type="L"><NOTNULL/><DEFAULT value="0"/></field>
		<field name="may_delete" type="L"><NOTNULL/><DEFAULT value="0"/></field>
		
		<data>
			<row><f>1</f><f>1</f><f>1</f><f>1</f><f>1</f><f>1</f></row>
			<row><f>1</f><f>2</f><f>1</f><f>1</f><f>0</f><f>0</f></row>
			<row><f>1</f><f>3</f><f>1</f><f>0</f><f>0</f><f>0</f></row>
		</data>
	</table>
	
	<table name="processors">
		<descr>### list of content processors</descr>
		<field name="name" type="C" size="255"><KEY/></field>
		<field name="public" type="L"><NOTNULL/></field>
		
		<data>
			<row><f>none</f><f>0</f></row>
			<row><f>bbcode</f><f>1</f></row>
			<row><f>xhtml</f><f>1</f></row>
		</data>
	</table>
	
	<table name="styles">
		<descr>Installed styles</descr>
		<field name="name" type="C" size="255"><KEY/></field>
		<field name="file" type="C" size="255"><NOTNULL/></field>
		
		<data>
			<row><f>Default Fuji</f><f>style/default/css/default.css</f></row>
			<row><f>Dark Fuji</f><f>style/dark/css/dark.css</f></row>
			<row><f>Fuji Lite</f><f>style/lite/css/lite.css</f></row>
			<row><f>Modern</f><f>style/modern/css/modern.css</f></row>
			<row><f>Modern Black</f><f>style/modern-black/css/modern-black.css</f></row>
			<row><f>Basic</f><f>style/basic/css/basic.css</f></row>
		</data>
	</table>
	
	<table name="languages">
		<descr>Installed languages</descr>
		<field name="id" type="C" size="12"><KEY/></field>
		<field name="name" type="C" size="255"><NOTNULL/></field>
		
		<data>
			<row><f>en-GB</f><f>English (Great Britain)</f></row>
			<row><f>nl-NL</f><f>Nederlands (Nederland)</f></row>
			<row><f>fr-FR</f><f>Français (France)</f></row>
			<row><f>ja-JP</f><f>日本語 (日本)</f></row>
		</data>
	</table>
	
	<table name="defaults">
		<descr>Default settings</descr>
		<field name="name" type="C" size="255"><KEY/></field>
		<field name="value" type="C" size="255"><NOTNULL/></field>
	</table>
	
	<table name="plugins">
		<descr>Plugins</descr>
		<field name="name" type="C" size="255"><KEY/></field>
		<field name="description" type="C" size="255"></field>
		<field name="author" type="C" size="255"></field>
		<field name="homepage" type="C" size="255"></field>
		<field name="version" type="C" size="10"></field>
		<field name="min_fuji_version" type="C" size="10"></field>
		<field name="max_fuji_version" type="C" size="10"></field>
		<field name="enabled" type="L"><NOTNULL/><DEFAULT value="1"/></field>
	</table>	
</schema>