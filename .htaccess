RewriteEngine On

##
## Different templates
## (not Last -> chain to item/*)
##

# GET /rss/*
RewriteRule ^rss/(.*)$ $1?template=RSS [QSA]

# GET /atom/*
RewriteRule ^atom/(.*)$ $1?template=Atom [QSA]

# GET /wml/*
RewriteRule ^wml/(.*)$ $1?template=WML [QSA]

# GET /xhtml/*
RewriteRule ^xhtml/(.*)$ $1?template=XHTML [QSA]


##
## Pretty URLs rewriting
##

# GET /
RewriteRule ^$ index.php [L,QSA]

# POST /item/
RewriteRule ^item/$ scripts/item.php [L,QSA]

# DELETE /item/<id>/
# GET /item/<id>/
# PUT /item/<id>/
RewriteRule ^item/(\d+)/?$ scripts/item.php?id=$1 [L,QSA]

# GET /item/<id>/source
RewriteRule ^item/(\d+)/source$ scripts/item_source.php?id=$1 [L,QSA]

# GET /item/<id>/<page>
RewriteRule ^item/(\d+)/(\d+)$ scripts/item.php?id=$1&page=$2 [L,QSA]

# GET /menu/
RewriteRule ^menu/$ scripts/menu.php [L,QSA]

# GET /menu/<action>
RewriteRule ^menu/(\w+)$ scripts/menu.php?action=$1 [L,QSA]

# GET /profile/<id>
RewriteRule ^profile/(\d+)$ scripts/profile.php?id=$1 [L,QSA]

# GET /profile
RewriteRule ^profile/$ scripts/profile.php [L,QSA]

# GET /install
RewriteRule ^install$ scripts/install/index.php [L,QSA]

# GET /register
RewriteRule ^register$ scripts/register/index.php [L,QSA]

# POST /preferences
RewriteRule ^preferences$ scripts/preferences.php [L,QSA]

# POST /serversettings
RewriteRule ^serversettings$ scripts/serversettings [L,QSA]

# POST /login
RewriteRule ^login$ scripts/loginout.php?action=login [L,QSA]

# POST /logout
RewriteRule ^logout$ scripts/loginout.php?action=logout [L,QSA]

# GET /users/
RewriteRule ^users/$ scripts/userlist.php [L,QSA]

# GET /users/<groupid>
RewriteRule ^users/(\d+)$  scripts/userlist.php?groupid=$1 [L,QSA]

# POST /editprofile/<id>
RewriteRule ^editprofile/(\d+)$ scripts/profile.php?id=$1&edit=true [L,QSA]

# POST /profile/<id>/updated
RewriteRule ^profile/(\d+)/updated$ scripts/profile.php?updated=true [L,QSA]

# GET /groups/
# POST /groups/
RewriteRule ^groups/$ scripts/groups.php [L,QSA]

# DELETE /groups/<groupid>
RewriteRule ^groups/(\d+)$ scripts/groups.php?id=$1 [L,QSA]

# GET /config_rights/<id>
RewriteRule ^config_rights/(\d+)$ scripts/config_rights.php?id=$1 [L,QSA]

# GET /statistics/
RewriteRule ^statistics/$ scripts/statistics.php [L,QSA]

